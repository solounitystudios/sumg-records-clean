# Supabase project credentials — copy to .env.local and fill in your values.
# Find these in your Supabase project dashboard under Settings → API.

# Your project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key — NEVER expose this in the browser or commit it.
# Only required for privileged server-side operations (createServiceClient).
SUPABASE_SERVICE_ROLE_KEY=

# Shopify (optional — leave blank to use fallback data)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Spotify — Client Credentials flow (server-side only, NEVER prefix with NEXT_PUBLIC_)
# Create an app at https://developer.spotify.com/dashboard and copy the Client ID + Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Public site URL — used for metadataBase, canonical URLs, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://sumgrecords.com
# Spotify (optional — leave blank to disable Spotify data on artist pages)
# Create an app at https://developer.spotify.com/dashboard and set the Client ID + Secret.
# These are SERVER-SIDE only and must never be prefixed with NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
