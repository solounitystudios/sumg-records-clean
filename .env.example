# Supabase project credentials — copy to .env.local and fill in your values.
# Find these in your Supabase project dashboard under Settings → API.

# Your project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key — NEVER expose this in the browser or commit it.
# Only required for privileged server-side operations (createServiceClient).
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used for metadataBase, canonical URLs, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://sumgrecords.com

# Spotify — Client Credentials flow (server-side only, NEVER prefix with NEXT_PUBLIC_)
# Create an app at https://developer.spotify.com/dashboard and copy the Client ID + Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 — OAuth 2.0 (server-side only, NEVER prefix with NEXT_PUBLIC_)
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Enable "YouTube Data API v3". Create OAuth 2.0 Client ID (Web Application type).
# Add authorized redirect URI: https://your-domain.com/api/youtube/oauth/callback
# Without these, the engine runs in Safe Mode (simulates uploads, no real API calls).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://your-domain.com/api/youtube/oauth/callback

# OpenAI — optional, used to enhance YouTube metadata (titles, description, tags) during Approve.
# If absent, the pipeline falls back to local template generation with no degradation.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Shopify (optional — leave blank to use fallback data)
# NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN — your myshopify.com domain, e.g. sumg-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Storefront Access Token (NOT the Admin API token)
# Create in Shopify admin → Sales Channels → Headless → Storefront API access tokens
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Admin API token — only needed for order management, not public storefront browsing
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Apple Music (optional — leave blank to disable Apple Music data)
# Obtain from https://developer.apple.com → Music ID → MusicKit
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_TEAM_ID=

# ffmpeg binary path for the render pipeline (server-side only)
# Dev: download static binary → curl -sL https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz | tar -xJ --strip-components=1 -C /tmp/ffmpeg
# Production: install via apt, Dockerfile, or Lambda layer, then set this to the binary path.
# Without this, /admin/youtube/render runs in degraded mode (shows deployment instructions).
FFMPEG_PATH=/tmp/ffmpeg/ffmpeg

# Cron secret — sent as Authorization header by Railway/Vercel cron to /api/youtube/cron
CRON_SECRET=
