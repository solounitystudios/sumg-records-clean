{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020"],
    "noEmit": false,
    "declaration": false,
    "incremental": false,
    "rootDir": "lib",
    "outDir": ".test-build",
    "jsx": "react-jsx"
  },
  "include": [
    "lib/catalog/**/*.ts",
    "lib/cms/*.security.test.ts",
    "lib/youtube/thumbnails/*.security.test.ts",
    "lib/youtube/oauth-state.ts",
    "lib/youtube/*.security.test.ts"
  ]
}
